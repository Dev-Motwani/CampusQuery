# ==========================================
# CampusQuery Environment Configuration
# ==========================================

# Flask Core Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# Database Configuration (MySQL Server / Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusqueri_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Backward Compatibility Aliases for MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=campusqueri_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Google Gemini API Key (Server-side Python Assistant only)
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload Settings (Bytes: 16MB = 16 * 1024 * 1024)
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
